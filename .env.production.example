# Laravel
APP_NAME="SmartLog Analyzer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_PORT=8080

# Logs
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# API y proveedor de análisis
SMARTLOG_API_KEY=
API_RATE_LIMIT_PER_MINUTE=60
LOG_ANALYSIS_RATE_LIMIT_PER_MINUTE=10
LLM_DRIVER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=30
OPENAI_CONNECT_TIMEOUT=5
OPENAI_MAX_OUTPUT_TOKENS=1500

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=smartlog
DB_USERNAME=smartlog
DB_PASSWORD=

# Redis y caché
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
ANALYSIS_CACHE_TTL=3600
ANALYSIS_LOCK_SECONDS=60

# Otros servicios de Laravel
SESSION_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
