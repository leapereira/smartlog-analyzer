# Laravel
APP_NAME="SmartLog Analyzer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_PORT=8080

# Logs
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# API y proveedor de análisis
SMARTLOG_API_KEY=
API_RATE_LIMIT_PER_MINUTE=60
LLM_DRIVER=openai
OPENAI_API_KEY=

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=smartlog
DB_USERNAME=smartlog
DB_PASSWORD=

# Redis y caché
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis

# Otros servicios de Laravel
SESSION_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
