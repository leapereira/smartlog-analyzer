# Laravel
APP_NAME="SmartLog Analyzer"
APP_ENV=local
# El entrypoint de Docker Compose genera APP_KEY si está vacía
APP_KEY=
APP_DEBUG=true
# APP_URL debe coincidir con el puerto publicado configurado en APP_PORT
APP_URL=http://localhost:8000
APP_PORT=8000

# Idioma de la aplicación y de los datos de prueba
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Canal y nivel de los logs de Laravel
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Acceso a la API y proveedor del análisis
SMARTLOG_API_KEY=smartlog-api-key
API_RATE_LIMIT_PER_MINUTE=60
LOG_ANALYSIS_RATE_LIMIT_PER_MINUTE=10
# Proveedor de LLM. Puede ser "openai" o "mock"
# "mock" es un proveedor de prueba que no requiere clave
LLM_DRIVER=mock
# OPENAI_API_KEY solo se usa con LLM_DRIVER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=30
OPENAI_CONNECT_TIMEOUT=5
OPENAI_MAX_OUTPUT_TOKENS=1500

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mydatabase
DB_USERNAME=myuser
DB_PASSWORD=mypassword

# Redis y caché
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_STORE=redis
ANALYSIS_CACHE_TTL=3600
ANALYSIS_LOCK_SECONDS=60

# Otros servicios de Laravel
SESSION_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
